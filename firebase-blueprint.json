{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil de usuario identificado apenas por nome de usuario sem senha.",
      "type": "object",
      "properties": {
        "usernameKey": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-z0-9._-]+$",
          "description": "Identificador unico normalizado em minusculas."
        },
        "displayName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "description": "Nome de exibicao escolhido pelo usuario."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp do servidor na criacao do perfil."
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp do servidor do ultimo acesso."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Indica se o usuario ja visualizou o guia inicial do metodo e concluiu ou pulou o tour."
        },
        "onboardingCompletedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp do servidor quando o onboarding foi concluido."
        }
      },
      "required": ["usernameKey", "displayName", "createdAt", "lastActiveAt"]
    },
    "TrainingSession": {
      "title": "TrainingSession",
      "description": "Sessao de treino ativo armazenada na subcolecao do usuario no Firestore.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "ownerUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-z0-9._-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "discipline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sourceType": {
          "type": "string",
          "enum": ["topic", "text", "git_kb", "weak_points"]
        },
        "sourceContent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "selectedKbPaths": {
          "type": "array"
        },
        "kbSources": {
          "type": "array"
        },
        "status": {
          "type": "string",
          "enum": ["choice_gate", "prep_class", "in_progress", "overtime", "completed"]
        },
        "wantsPrepClass": {
          "type": "boolean"
        },
        "currentRound": {
          "type": "integer"
        },
        "syllabus": {
          "type": "array"
        },
        "prepClass": {
          "type": "object"
        },
        "rounds": {
          "type": "array"
        },
        "activeWeakPoints": {
          "type": "array"
        },
        "strategicSyntheses": {
          "type": "array"
        },
        "finalSynthesis": {
          "type": "object"
        },
        "surgicalFocus": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUsername",
        "title",
        "sourceType",
        "sourceContent",
        "status",
        "wantsPrepClass",
        "currentRound",
        "syllabus",
        "rounds",
        "activeWeakPoints",
        "strategicSyntheses",
        "createdAt",
        "updatedAt"
      ]
    },
    "WeakPointBankEntry": {
      "title": "WeakPointBankEntry",
      "description": "Registro persistente de ponto fraco ou acerto por chute agrupado por disciplina.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "ownerUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-z0-9._-]+$"
        },
        "discipline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "concept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "definition": {
          "type": "string",
          "maxLength": 2000
        },
        "subtopic": {
          "type": "string",
          "maxLength": 240
        },
        "sourceSessionId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "sourceSessionTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "enum": ["active", "mastered"]
        },
        "lastTrigger": {
          "type": "string",
          "enum": ["incorrect", "partial", "lucky_guess", "unsure_hit"]
        },
        "errorCount": {
          "type": "integer"
        },
        "guessCount": {
          "type": "integer"
        },
        "retestSuccessCount": {
          "type": "integer"
        },
        "lastErrorCause": {
          "type": "string",
          "enum": ["lack_of_theory", "rushed_reading", "concept_confusion", "detail_slip"]
        },
        "errorCauseCounts": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUsername",
        "discipline",
        "concept",
        "definition",
        "subtopic",
        "sourceSessionId",
        "sourceSessionTitle",
        "status",
        "lastTrigger",
        "errorCount",
        "guessCount",
        "retestSuccessCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ComparativeTable": {
      "title": "ComparativeTable",
      "description": "Quadro comparativo entre conceitos parecidos salvo na biblioteca do usuario.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "ownerUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-z0-9._-]+$"
        },
        "discipline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "conceptA": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "conceptB": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "triggerReason": {
          "type": "string",
          "enum": ["auto_confusion", "on_demand"]
        },
        "rows": {
          "type": "array"
        },
        "summaryTip": {
          "type": "string",
          "maxLength": 1000
        },
        "sourceSessionId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUsername",
        "discipline",
        "title",
        "conceptA",
        "conceptB",
        "triggerReason",
        "rows",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{usernameKey}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Perfis individuais identificados apenas por nome de usuario normalizado."
    },
    "/users/{usernameKey}/sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/TrainingSession"
      },
      "description": "Historico e progresso em nuvem das sessoes de treino ativo isoladas por usuario."
    },
    "/users/{usernameKey}/weakPoints/{weakPointId}": {
      "schema": {
        "$ref": "#/entities/WeakPointBankEntry"
      },
      "description": "Banco de erros e acertos frageis agrupados por disciplina para reteste sob demanda."
    },
    "/users/{usernameKey}/comparativeTables/{tableId}": {
      "schema": {
        "$ref": "#/entities/ComparativeTable"
      },
      "description": "Quadros comparativos automaticos e sob demanda salvos na biblioteca do usuario."
    }
  }
}
