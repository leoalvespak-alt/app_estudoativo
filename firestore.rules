rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidUsernameKey(key) {
      return key is string && key.size() >= 3 && key.size() <= 32 && key.matches('^[a-z0-9._-]+$');
    }

    function isValidUserProfile(data, usernameKey) {
      return data.keys().hasAll(['usernameKey', 'displayName', 'createdAt', 'lastActiveAt'])
        && data.keys().hasOnly([
          'usernameKey',
          'displayName',
          'createdAt',
          'lastActiveAt',
          'onboardingCompleted',
          'onboardingCompletedAt'
        ])
        && data.usernameKey == usernameKey
        && isValidUsernameKey(data.usernameKey)
        && data.displayName is string
        && data.displayName.size() >= 3
        && data.displayName.size() <= 40
        && data.createdAt is timestamp
        && data.lastActiveAt is timestamp
        && isValidOptionalBool(data, 'onboardingCompleted')
        && isValidOptionalTimestamp(data, 'onboardingCompletedAt');
    }

    function isValidOptionalMap(data, key) {
      return !(key in data) || data[key] == null || data[key] is map;
    }

    function isValidOptionalBool(data, key) {
      return !(key in data) || data[key] == null || data[key] is bool;
    }

    function isValidOptionalTimestamp(data, key) {
      return !(key in data) || data[key] == null || data[key] is timestamp;
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidOptionalStringList(data, key, maxLen) {
      return !(key in data)
        || (data[key] is list && data[key].size() <= maxLen && (data[key].size() == 0 || data[key][0] is string));
    }

    function isValidOptionalMapList(data, key, maxLen) {
      return !(key in data)
        || (data[key] is list && data[key].size() <= maxLen && (data[key].size() == 0 || data[key][0] is map));
    }

    function isValidTrainingSession(data, usernameKey, sessionId) {
      return data.keys().hasAll([
          'id',
          'ownerUsername',
          'title',
          'sourceType',
          'sourceContent',
          'status',
          'wantsPrepClass',
          'currentRound',
          'syllabus',
          'rounds',
          'activeWeakPoints',
          'strategicSyntheses',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerUsername',
          'title',
          'discipline',
          'sourceType',
          'sourceContent',
          'selectedKbPaths',
          'kbSources',
          'status',
          'wantsPrepClass',
          'currentRound',
          'syllabus',
          'prepClass',
          'rounds',
          'activeWeakPoints',
          'strategicSyntheses',
          'finalSynthesis',
          'surgicalFocus',
          'createdAt',
          'updatedAt'
        ])
        && data.id == sessionId
        && isValidId(data.id)
        && data.ownerUsername == usernameKey
        && isValidUsernameKey(data.ownerUsername)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && isValidOptionalString(data, 'discipline', 100)
        && data.sourceType in ['topic', 'text', 'git_kb', 'weak_points']
        && data.sourceContent is string
        && data.sourceContent.size() >= 1
        && data.sourceContent.size() <= 20000
        && isValidOptionalStringList(data, 'selectedKbPaths', 20)
        && isValidOptionalMapList(data, 'kbSources', 20)
        && data.status in ['choice_gate', 'prep_class', 'in_progress', 'overtime', 'completed']
        && data.wantsPrepClass is bool
        && data.currentRound is int
        && data.currentRound >= 1
        && data.currentRound <= 30
        && data.syllabus is list
        && data.syllabus.size() <= 10
        && (data.syllabus.size() == 0 || data.syllabus[0] is map)
        && data.rounds is list
        && data.rounds.size() <= 30
        && (data.rounds.size() == 0 || data.rounds[0] is map)
        && data.activeWeakPoints is list
        && data.activeWeakPoints.size() <= 100
        && (data.activeWeakPoints.size() == 0 || data.activeWeakPoints[0] is map)
        && data.strategicSyntheses is list
        && data.strategicSyntheses.size() <= 5
        && (data.strategicSyntheses.size() == 0 || data.strategicSyntheses[0] is map)
        && isValidOptionalMap(data, 'prepClass')
        && isValidOptionalMap(data, 'finalSynthesis')
        && isValidOptionalMap(data, 'surgicalFocus')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWeakPointBankEntry(data, usernameKey, weakPointId) {
      return data.keys().hasAll([
          'id',
          'ownerUsername',
          'discipline',
          'concept',
          'definition',
          'subtopic',
          'sourceSessionId',
          'sourceSessionTitle',
          'status',
          'lastTrigger',
          'errorCount',
          'guessCount',
          'retestSuccessCount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerUsername',
          'discipline',
          'concept',
          'definition',
          'subtopic',
          'sourceSessionId',
          'sourceSessionTitle',
          'status',
          'lastTrigger',
          'errorCount',
          'guessCount',
          'retestSuccessCount',
          'lastErrorCause',
          'errorCauseCounts',
          'createdAt',
          'updatedAt'
        ])
        && data.id == weakPointId
        && isValidId(data.id)
        && data.ownerUsername == usernameKey
        && isValidUsernameKey(data.ownerUsername)
        && data.discipline is string
        && data.discipline.size() >= 1
        && data.discipline.size() <= 100
        && data.concept is string
        && data.concept.size() >= 1
        && data.concept.size() <= 240
        && data.definition is string
        && data.definition.size() <= 2000
        && data.subtopic is string
        && data.subtopic.size() <= 240
        && data.sourceSessionId is string
        && isValidId(data.sourceSessionId)
        && data.sourceSessionTitle is string
        && data.sourceSessionTitle.size() >= 1
        && data.sourceSessionTitle.size() <= 160
        && data.status in ['active', 'mastered']
        && data.lastTrigger in ['incorrect', 'partial', 'lucky_guess', 'unsure_hit']
        && data.errorCount is int
        && data.errorCount >= 0
        && data.errorCount <= 10000
        && data.guessCount is int
        && data.guessCount >= 0
        && data.guessCount <= 10000
        && data.retestSuccessCount is int
        && data.retestSuccessCount >= 0
        && data.retestSuccessCount <= 10000
        && (!('lastErrorCause' in data) || data.lastErrorCause == null || data.lastErrorCause in ['lack_of_theory', 'rushed_reading', 'concept_confusion', 'detail_slip'])
        && isValidOptionalMap(data, 'errorCauseCounts')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidComparativeTable(data, usernameKey, tableId) {
      return data.keys().hasAll([
          'id',
          'ownerUsername',
          'discipline',
          'title',
          'conceptA',
          'conceptB',
          'triggerReason',
          'rows',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerUsername',
          'discipline',
          'title',
          'conceptA',
          'conceptB',
          'triggerReason',
          'rows',
          'summaryTip',
          'sourceSessionId',
          'createdAt',
          'updatedAt'
        ])
        && data.id == tableId
        && isValidId(data.id)
        && data.ownerUsername == usernameKey
        && isValidUsernameKey(data.ownerUsername)
        && data.discipline is string
        && data.discipline.size() >= 1
        && data.discipline.size() <= 100
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && data.conceptA is string
        && data.conceptA.size() >= 1
        && data.conceptA.size() <= 160
        && data.conceptB is string
        && data.conceptB.size() >= 1
        && data.conceptB.size() <= 160
        && data.triggerReason in ['auto_confusion', 'on_demand']
        && data.rows is list
        && data.rows.size() >= 1
        && data.rows.size() <= 15
        && data.rows[0] is map
        && isValidOptionalString(data, 'summaryTip', 1000)
        && isValidOptionalString(data, 'sourceSessionId', 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{usernameKey} {
      allow get: if isValidUsernameKey(usernameKey);
      allow list: if false;

      allow create: if isValidUsernameKey(usernameKey)
        && isValidUserProfile(incoming(), usernameKey)
        && incoming().createdAt == request.time
        && incoming().lastActiveAt == request.time
        && (!('onboardingCompletedAt' in incoming()) || incoming().onboardingCompletedAt == null || incoming().onboardingCompletedAt == request.time);

      allow update: if isValidUsernameKey(usernameKey)
        && isValidUserProfile(incoming(), usernameKey)
        && incoming().usernameKey == existing().usernameKey
        && incoming().createdAt == existing().createdAt
        && incoming().lastActiveAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'lastActiveAt'])
          || (
            incoming().onboardingCompleted is bool
            && incoming().onboardingCompletedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'onboardingCompleted',
              'onboardingCompletedAt',
              'lastActiveAt'
            ])
          )
        );

      allow delete: if false;

      match /sessions/{sessionId} {
        allow get: if isValidUsernameKey(usernameKey)
          && isValidId(sessionId);

        allow list: if isValidUsernameKey(usernameKey)
          && resource.data.ownerUsername == usernameKey;

        allow create: if isValidUsernameKey(usernameKey)
          && isValidId(sessionId)
          && isValidTrainingSession(incoming(), usernameKey, sessionId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(usernameKey));

        allow update: if isValidUsernameKey(usernameKey)
          && isValidId(sessionId)
          && isValidTrainingSession(incoming(), usernameKey, sessionId)
          && incoming().id == existing().id
          && incoming().ownerUsername == existing().ownerUsername
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && existing().status != 'completed'
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'discipline',
            'kbSources',
            'status',
            'wantsPrepClass',
            'currentRound',
            'syllabus',
            'prepClass',
            'rounds',
            'activeWeakPoints',
            'strategicSyntheses',
            'finalSynthesis',
            'updatedAt'
          ]);

        allow delete: if isValidUsernameKey(usernameKey)
          && isValidId(sessionId);
      }

      match /weakPoints/{weakPointId} {
        allow get: if isValidUsernameKey(usernameKey)
          && isValidId(weakPointId);

        allow list: if isValidUsernameKey(usernameKey)
          && resource.data.ownerUsername == usernameKey;

        allow create: if isValidUsernameKey(usernameKey)
          && isValidId(weakPointId)
          && isValidWeakPointBankEntry(incoming(), usernameKey, weakPointId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(usernameKey));

        allow update: if isValidUsernameKey(usernameKey)
          && isValidId(weakPointId)
          && isValidWeakPointBankEntry(incoming(), usernameKey, weakPointId)
          && incoming().id == existing().id
          && incoming().ownerUsername == existing().ownerUsername
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'discipline',
            'concept',
            'definition',
            'subtopic',
            'sourceSessionId',
            'sourceSessionTitle',
            'status',
            'lastTrigger',
            'errorCount',
            'guessCount',
            'retestSuccessCount',
            'lastErrorCause',
            'errorCauseCounts',
            'updatedAt'
          ]);

        allow delete: if isValidUsernameKey(usernameKey)
          && isValidId(weakPointId);
      }

      match /comparativeTables/{tableId} {
        allow get: if isValidUsernameKey(usernameKey)
          && isValidId(tableId);

        allow list: if isValidUsernameKey(usernameKey)
          && resource.data.ownerUsername == usernameKey;

        allow create: if isValidUsernameKey(usernameKey)
          && isValidId(tableId)
          && isValidComparativeTable(incoming(), usernameKey, tableId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(usernameKey));

        allow update: if isValidUsernameKey(usernameKey)
          && isValidId(tableId)
          && isValidComparativeTable(incoming(), usernameKey, tableId)
          && incoming().id == existing().id
          && incoming().ownerUsername == existing().ownerUsername
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'discipline',
            'title',
            'conceptA',
            'conceptB',
            'triggerReason',
            'rows',
            'summaryTip',
            'sourceSessionId',
            'updatedAt'
          ]);

        allow delete: if isValidUsernameKey(usernameKey)
          && isValidId(tableId);
      }
    }
  }
}
